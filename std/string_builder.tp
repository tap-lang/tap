import std.byte_vec as bytes;
import std.byte_vec.ByteVec;

// 基于 ByteVec 的增量字符串构建器。
//
// 和 `Vec` / `ByteVec` 一样是引用接口：读操作收 `&StringBuilder`，写操作收
// `&mut StringBuilder`，写完不用再赋回变量。`free` 仍然按值收 —— 它把内部缓冲区
// 交还给分配器，之后这个构建器不该再被使用。
pub struct StringBuilder {
    buffer: ByteVec,
}

// 使用指定初始容量创建空构建器。
pub fn with_capacity(capacity: uint): StringBuilder {
    return StringBuilder {
        buffer: bytes.with_capacity(capacity),
    };
}

// 使用默认容量 32 创建空构建器。
pub fn new(): StringBuilder {
    return with_capacity(32);
}

// 返回当前已追加的 UTF-8 字节数。
pub fn len(builder: &StringBuilder): uint {
    return bytes.len(&builder.buffer);
}

// 追加一个原始字节。
pub fn append_byte(builder: &mut StringBuilder, value: u8) {
    bytes.push(&mut builder.buffer, value);
}

// 追加 String 或任意可显式转换为 String 的标量值。
// 具体类型由调用点推断，因此整数、浮点数和 bool 共用这一套接口。
pub fn append<T>(builder: &mut StringBuilder, value: T) {
    let text: String = value as String;
    bytes.extend(&mut builder.buffer, text);
}

// 清空内容但保留内部容量。
pub fn clear(builder: &mut StringBuilder) {
    bytes.clear(&mut builder.buffer);
}

// 返回独立字符串快照；后续修改构建器不会改变该字符串。
pub fn to_string(builder: &StringBuilder): String {
    return bytes.to_string(&builder.buffer);
}

// 释放内部缓冲区；调用后不能继续使用这个 StringBuilder。
pub fn free(builder: StringBuilder): i32 {
    return bytes.free(builder.buffer);
}
