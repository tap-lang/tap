// 堆内存管理所需的内部 Runtime ABI。
extern fn __tap_malloc(size: uint): *i8;
extern fn __tap_realloc(pointer: *i8, size: uint): *i8;
extern fn __tap_free(pointer: *i8): i32;

// 分配 size 字节的未初始化堆内存，并按调用处推断的 T 返回指针。
fn malloc<T>(size: uint): *T {
    return __tap_malloc(size);
}

// 把已有堆内存调整为 size 字节，原指针在成功后不应继续使用。
fn realloc<T>(pointer: *T, size: uint): *T {
    return __tap_realloc(pointer, size);
}

// 释放由本模块分配的堆内存；调用后不能继续访问该指针。
fn free<T>(pointer: *T): i32 {
    return __tap_free(pointer);
}
