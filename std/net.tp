// TCP 套接字（IPv4）。
//
// 平台差异收在 Runtime 的 `__tap_socket_*` 里：POSIX 走 libc 的 BSD socket，
// Windows 走 winsock（需要先 WSAStartup、句柄是 64 位 SOCKET、关闭要用 closesocket）。
// tap 没有条件编译，所以这层差异只能由 C 侧的 Runtime 承担 —— 这也是本模块唯一
// 需要 Runtime 的地方。macOS / Linux / Cygwin 和原生 Windows（MSVC / MinGW）都可用。
//
// 三件必须知道的事：
//   - **全程阻塞，没有超时**。accept / connect / receive 都会一直等下去，对端不响应时
//     调用方就卡住了；需要超时得自己配合非阻塞模式，本模块还没做。
//   - **`Socket` 是值类型**，`close_socket()` 拿到的是副本，没法把调用方手里的句柄置空。
//     和 std.fs 不同，这里没有 Runtime 侧的句柄登记表，所以关闭之后必须**把返回值赋回去**：
//         socket = net.close_socket(socket);
//     不赋值的话，旧副本的 fd 仍然是正数，is_open 会误判为「还开着」。
//   - **只认 IPv4 字面量**，不做域名解析。
//
// 典型用法（服务器）：
//     let server: Socket = unwrap(net.listen_on("127.0.0.1", 8080, 8));
//     let client: Socket = unwrap(net.accept_from(server));
//     let buffer: [u8; 1024] = [0; 1024];
//     let count: i64 = net.receive(client, &buffer[0], 1024);

// 套接字原语的 Runtime ABI。句柄是 i64，负值表示无效。
// 名字统一以 __tap_ 开头，不会像直接用 socket / bind / listen 那样占住通用全局名。
extern fn __tap_socket_create(): i64;
extern fn __tap_socket_bind(handle: i64, address: *u8, length: u32): i32;
extern fn __tap_socket_listen(handle: i64, backlog: i32): i32;
extern fn __tap_socket_accept(handle: i64): i64;
extern fn __tap_socket_connect(handle: i64, address: *u8, length: u32): i32;
extern fn __tap_socket_getsockname(handle: i64, address: *u8, length: *u32): i32;
extern fn __tap_socket_recv(handle: i64, buffer: *u8, length: uint): i64;
extern fn __tap_socket_send(handle: i64, buffer: *u8, length: uint): i64;
extern fn __tap_socket_send_text(handle: i64, data: string): i64;
extern fn __tap_socket_close(handle: i64): i32;

// 地址族：IPv4。sockaddr_in 里 family 字段的值，两平台一致。
pub const AF_INET: i32 = 2;

// 套接字类型：面向连接的字节流（TCP）。由 Runtime 固定使用，这里导出供参考。
pub const SOCK_STREAM: i32 = 1;

// sockaddr_in 的固定长度；IPv4 地址结构就 16 字节。
pub const ADDRESS_LENGTH: u32 = 16;

// 一个套接字。`fd` 小于 0 表示已关闭或者创建失败，不要直接读写它。
pub struct Socket {
    fd: i64,
}

// 把 "a.b.c.d" 形式的 IPv4 字面量解析成 4 个字节。
// 每段必须是 0..255 的十进制数、不能为空、必须正好 4 段，否则返回 Err。
//
// 只认字面量，不做 DNS 解析——tap 现在还没有域名解析。
pub fn parse_ipv4(host: string): Result<[u8; 4], string> {
    let bytes: [u8; 4] = [0; 4];
    let index: uint = 0;
    let part: i32 = 0;      // 当前这一段的数值
    let digits: i32 = 0;    // 当前这一段已经吃进来的数字个数
    let count: i32 = 0;     // 已经写完的段数

    while (index < host.len()) {
        let c: u8 = host.byte_at(index);
        if (c == 46) {                                  // '.'
            if (digits == 0 || count >= 3) {            // 空段，或者已经够 4 段了
                return Result<[u8; 4], string>.Err("invalid IPv4 address");
            }
            bytes[count] = part;
            count = count + 1;
            part = 0;
            digits = 0;
        } else if (c >= 48 && c <= 57) {                // '0'..'9'
            part = part * 10 + (c - 48);
            digits = digits + 1;
            if (part > 255) {
                return Result<[u8; 4], string>.Err("IPv4 octet out of range");
            }
        } else {
            return Result<[u8; 4], string>.Err("invalid IPv4 address");
        }
        index = index + 1;
    }

    if (digits == 0 || count != 3) {
        return Result<[u8; 4], string>.Err("invalid IPv4 address");
    }
    bytes[3] = part;
    return Result<[u8; 4], string>.Ok(bytes);
}

// 构造 16 字节的 sockaddr_in：family 在偏移 0，端口在偏移 2，地址在偏移 4，其余补零。
// 地址非法时返回 Err。
//
// 端口和地址都按大端（网络字节序）手工拆字节。这里刻意不用 libc 的 htons：
// htons 返回的 u16 要靠「内存布局」才是网络序，而 tap 的整数是数值语义，再从数值里拆
// 字节就得先知道宿主机端序了；直接按数值拆反而端序无关。
pub fn build_address(host: string, port: u16): Result<[u8; 16], string> {
    let parsed: Result<[u8; 4], string> = parse_ipv4(host);
    if (is_err(parsed)) {
        return Result<[u8; 16], string>.Err("invalid IPv4 address");
    }
    let host_bytes: [u8; 4] = unwrap(parsed);

    let address: [u8; 16] = [0; 16];
    address[0] = AF_INET;
    address[2] = (port >> 8) & 255;     // 端口高字节在前
    address[3] = port & 255;
    address[4] = host_bytes[0];
    address[5] = host_bytes[1];
    address[6] = host_bytes[2];
    address[7] = host_bytes[3];
    return Result<[u8; 16], string>.Ok(address);
}

// 是否持有有效句柄。创建失败、或者 close_socket 返回的那个句柄都返回 false。
pub fn is_open(socket: Socket): bool {
    return socket.fd >= 0;
}

// 创建、绑定并开始监听，返回监听中的服务器套接字。
//
// `port` 传 0 表示让内核随便挑一个空闲端口，之后用 local_port 取回来；
// `backlog` 是等待 accept 的连接队列长度，普通场景 8 就够。
// 地址非法、端口被占用或权限不足时返回 Err。
pub fn listen_on(host: string, port: u16, backlog: i32): Result<Socket, string> {
    let built: Result<[u8; 16], string> = build_address(host, port);
    if (is_err(built)) {
        return Result<Socket, string>.Err("invalid IPv4 address");
    }
    let address: [u8; 16] = unwrap(built);

    let fd: i64 = __tap_socket_create();
    if (fd < 0) {
        return Result<Socket, string>.Err("socket() failed");
    }
    if (__tap_socket_bind(fd, &address[0], ADDRESS_LENGTH) != 0) {
        __tap_socket_close(fd);
        return Result<Socket, string>.Err("bind() failed");
    }
    if (__tap_socket_listen(fd, backlog) != 0) {
        __tap_socket_close(fd);
        return Result<Socket, string>.Err("listen() failed");
    }
    return Result<Socket, string>.Ok(Socket { fd: fd });
}

// 连接服务器，返回已连上的套接字；地址非法或对方拒绝连接时返回 Err。
//
// 注意这是阻塞连接：对方不回应会一直等，而且不像 C 那样有超时选项。
pub fn connect_to(host: string, port: u16): Result<Socket, string> {
    let built: Result<[u8; 16], string> = build_address(host, port);
    if (is_err(built)) {
        return Result<Socket, string>.Err("invalid IPv4 address");
    }
    let address: [u8; 16] = unwrap(built);

    let fd: i64 = __tap_socket_create();
    if (fd < 0) {
        return Result<Socket, string>.Err("socket() failed");
    }
    if (__tap_socket_connect(fd, &address[0], ADDRESS_LENGTH) != 0) {
        __tap_socket_close(fd);
        return Result<Socket, string>.Err("connect() failed");
    }
    return Result<Socket, string>.Ok(Socket { fd: fd });
}

// 从监听套接字上取一个已完成握手的连接，阻塞直到有连接进来。
// 传入的句柄已关闭、或者底层 accept 失败时返回 Err。
//
// 对端地址这里不返回，所以底层也不需要接收它的缓冲区。
pub fn accept_from(server: Socket): Result<Socket, string> {
    if (!is_open(server)) {
        return Result<Socket, string>.Err("socket is closed");
    }
    let fd: i64 = __tap_socket_accept(server.fd);
    if (fd < 0) {
        return Result<Socket, string>.Err("accept() failed");
    }
    return Result<Socket, string>.Ok(Socket { fd: fd });
}

// 返回套接字实际绑定的端口；句柄无效或查询失败时返回 0。
// 服务器绑定端口 0 之后靠它取回内核分配的端口。
pub fn local_port(socket: Socket): u16 {
    if (!is_open(socket)) {
        return 0;
    }
    let address: [u8; 16] = [0; 16];
    let length: u32 = ADDRESS_LENGTH;
    if (__tap_socket_getsockname(socket.fd, &address[0], &length) != 0) {
        return 0;
    }
    return address[2] * 256 + address[3];
}

// 收数据，最多 capacity 个字节写进调用方给的缓冲区。
//
// 返回值：> 0 是实际收到的字节数；0 表示对端已经正常关闭；-1 表示句柄无效或出错。
// 阻塞直到有数据或连接结束，缓冲区由调用方提供，本函数不分配内存。
//
// 收到的字节不会被当成字符串处理，所以内容里含 NUL 也不会出事——逐字节读 buffer 即可。
pub fn receive(socket: Socket, buffer: *u8, capacity: uint): i64 {
    if (!is_open(socket)) {
        return -1;
    }
    return __tap_socket_recv(socket.fd, buffer, capacity);
}

// 发送字符串的全部字节，返回**实际发出的字节数**；句柄无效或出错返回 -1。
//
// 一次 send 不保证把数据发完，返回小于 data.len() 时调用方要自己接着发剩下的部分
// （tap 还没有指针算术，切不出「后半段字符串」，所以这里没有提供自动重发的 send_all）。
pub fn send_text(socket: Socket, data: string): i64 {
    if (!is_open(socket)) {
        return -1;
    }
    return __tap_socket_send_text(socket.fd, data);
}

// 发送缓冲区里的 length 个字节，返回**实际发出的字节数**；句柄无效或出错返回 -1。
//
// 和 receive 配对：收到的是裸字节，直接丢回 send_bytes 就能原样回显，内容里含 NUL
// 也没问题——send_text 只收字符串，发不出这种数据。
pub fn send_bytes(socket: Socket, buffer: *u8, length: uint): i64 {
    if (!is_open(socket)) {
        return -1;
    }
    return __tap_socket_send(socket.fd, buffer, length);
}

// 关闭套接字，返回关闭后的句柄（fd 变成 -1）。
//
// 因为 Socket 是值类型，关闭的效果只能通过返回值传出去，所以用法是：
//     socket = net.close_socket(socket);
// 忘了赋值的话，手里的旧副本仍然带着原来的 fd，is_open 会误判成还开着；
// 而那个 fd 可能已经被系统分配给了别的连接，继续用就是操作别人的连接。
//
// 对已经关闭的句柄重复调用是安全的，不会有副作用。
pub fn close_socket(socket: Socket): Socket {
    if (is_open(socket)) {
        __tap_socket_close(socket.fd);
    }
    return Socket { fd: -1 };
}
