extern fn __4yue_argc(): i32;
extern fn __4yue_arg(index: i32): string;

fn argc(): i32 {
    return __4yue_argc();
}

fn arg(index: i32): string {
    return __4yue_arg(index);
}

fn args(): [string; 64] {
    let values: [string; 64] = [""; 64];
    let count: i32 = __4yue_argc();
    if (count > 64) {
        count = 64;
    }

    for (let i: i32 = 0; i < count; i++) {
        values[i] = __4yue_arg(i);
    }
    return values;
}
