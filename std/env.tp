extern fn __tap_argc(): i32;
extern fn __tap_arg(index: i32): string;
extern fn __tap_env_var(name: string): string;
extern fn __tap_envc(): i32;
extern fn __tap_env(index: i32): string;

// 获取命令行参数数量
fn argc(): i32 {
    return __tap_argc();
}

// 通过索引获取命令行参数
fn arg(index: i32): string {
    return __tap_arg(index);
}

// 获取所有命令行参数
fn args(): [string; 64] {
    let values: [string; 64] = [""; 64];
    let count: i32 = __tap_argc();
    if (count > 64) {
        count = 64;
    }

    for (let i: i32 = 0; i < count; i++) {
        values[i] = __tap_arg(i);
    }
    return values;
}

// 通过 name 获取环境变量
fn var(name: string): string {
    return __tap_env_var(name);
}

// 获取环境变量的数量
fn varc(): i32 {
    return __tap_envc();
}

// 获取所有环境变量
fn vars(): [string; 256] {
    let values: [string; 256] = [""; 256];
    let count: i32 = __tap_envc();
    if (count > 256) {
        count = 256;
    }

    for (let i: i32 = 0; i < count; i++) {
        values[i] = __tap_env(i);
    }
    return values;
}
