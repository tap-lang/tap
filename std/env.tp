import std.vec as vec;

// 命令行参数和环境变量访问所需的内部 Runtime ABI。
extern fn __tap_argc(): i32;
extern fn __tap_arg(index: i32): string;
extern fn __tap_env_var(name: string): string;
extern fn __tap_envc(): i32;
extern fn __tap_env(index: i32): string;

// 返回命令行参数数量，其中第一个参数通常是程序路径。
pub fn argc(): i32 {
    return __tap_argc();
}

// 返回指定位置的命令行参数；索引越界时返回空字符串。
pub fn arg(index: i32): string {
    return __tap_arg(index);
}

// 返回全部命令行参数，第一个通常是程序路径。
//
// 用 Vec<string> 而不是定长数组：参数个数不再受上限限制，也不需要空串填充。
// 代价是容器在堆上，**调用方用完要自己 vec.free 释放**——tap 的结构体没有析构。
// 只要不 free 也只是进程退出前一直占着，不会出错。
pub fn args(): Vec<string> {
    let values: Vec<string> = vec.new();
    let count: i32 = __tap_argc();
    for (let i: i32 = 0; i < count; i++) {
        values = vec.push(values, __tap_arg(i));
    }
    return values;
}

// 返回指定名称的环境变量；名称为空或变量不存在时返回空字符串。
pub fn var(name: string): string {
    return __tap_env_var(name);
}

// 返回当前进程的环境变量数量。
pub fn varc(): i32 {
    return __tap_envc();
}

// 返回全部 NAME=VALUE 环境变量条目，同样需要调用方 free。
pub fn vars(): Vec<string> {
    let values: Vec<string> = vec.new();
    let count: i32 = __tap_envc();
    for (let i: i32 = 0; i < count; i++) {
        values = vec.push(values, __tap_env(i));
    }
    return values;
}
