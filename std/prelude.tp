fn min(a: i32, b: i32): i32 {
    if (a < b) {
        return a;
    } else {
        return b;
    }
}

fn max(a: i32, b: i32): i32 {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fn abs(value: i32): i32 {
    if (value < 0) {
        return -value;
    } else {
        return value;
    }
}
