// 跨平台终端、计时、随机数和终止程序所需的内部 Runtime ABI。
extern fn __tap_read_key(): i32;
extern fn __tap_sleep_ms(milliseconds: i32): i32;
extern fn __tap_clear_screen(): i32;
extern fn __tap_random(maximum: i32): i32;
extern fn __tap_panic(message: string): i32;

// 非阻塞读取一个按键；当前无按键或输入不是终端时返回 -1。
fn read_key(): i32 {
    return __tap_read_key();
}

// 暂停指定毫秒数；参数为负数或系统调用失败时返回 -1。
fn sleep_ms(milliseconds: i32): i32 {
    return __tap_sleep_ms(milliseconds);
}

// 清空终端并把光标移到左上角；操作成功时返回 0。
fn clear_screen(): i32 {
    return __tap_clear_screen();
}

// 返回 [0, maximum) 范围内的伪随机整数；maximum 不大于 0 时返回 0。
fn random(maximum: i32): i32 {
    return __tap_random(maximum);
}

// 打印 `panic: <message>` 到标准错误，并以状态 1 终止程序。
// 用于调用方无法合理恢复的情况；可恢复的错误应当用 std.result 的 Result 交给调用方。
// 函数不会返回；返回 i32 只是为了让 tap 侧能当普通调用使用。
fn panic(message: string): i32 {
    return __tap_panic(message);
}

// 可恢复错误的标准表示：`Ok(T)` 携带成功值，`Err(E)` 携带错误信息，实践中 `E` 多为
// `string`。用它取代「返回哨兵值」和「打印后继续」这两种含糊的做法。
//
// Result 放在 Prelude 里，所以类型名和下面几个辅助函数都不需要导入。取值用 match 的
// 表达式形式，或者用 unwrap_or 给兜底值、unwrap / expect 直接 panic。
enum Result<T, E> {
    Ok(T),
    Err(E),
}

// 是否为成功值。
fn is_ok<T, E>(value: Result<T, E>): bool {
    return match (value) {
        Result.Ok(inner) => true,
        Result.Err(reason) => false,
    };
}

// 是否为失败值。
fn is_err<T, E>(value: Result<T, E>): bool {
    return match (value) {
        Result.Ok(inner) => false,
        Result.Err(reason) => true,
    };
}

// 取成功值；失败时返回 fallback。
fn unwrap_or<T, E>(value: Result<T, E>, fallback: T): T {
    return match (value) {
        Result.Ok(inner) => inner,
        Result.Err(reason) => fallback,
    };
}

// 取成功值；遇到 Err 直接 panic，错误信息用 Err 携带的那个。
//
// 只支持 `Result<T, string>`：tap 还没有「把任意类型转成字符串」的手段，所以错误类型
// 必须是 string 才报得出有用的信息。其他错误类型请自己 match。
fn unwrap<T>(value: Result<T, string>): T {
    // panic 不返回，所以 Err 那条路不需要再给出值；函数末尾也就没有返回值。
    match (value) {
        Result.Ok(inner) => {
            return inner;
        }
        Result.Err(reason) => {
            panic(reason);
        }
    }
}

// 同 unwrap，但 panic 时用 message 而不是 Err 携带的信息。
fn expect<T>(value: Result<T, string>, message: string): T {
    match (value) {
        Result.Ok(inner) => {
            return inner;
        }
        Result.Err(reason) => {
            panic(message);
        }
    }
}

// 返回两个 i32 中较小的值。
fn min(a: i32, b: i32): i32 {
    if (a < b) {
        return a;
    } else {
        return b;
    }
}

// 返回两个 i32 中较大的值。
fn max(a: i32, b: i32): i32 {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}
