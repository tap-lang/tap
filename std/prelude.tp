// Runtime ABI declarations use a prefix so they never collide with libc symbols.
extern fn yue_read_key(): i32;
extern fn yue_sleep_ms(milliseconds: i32): i32;
extern fn yue_clear_screen(): i32;
extern fn yue_random(maximum: i32): i32;

// Public wrappers keep operating-system details outside normal 4yue programs.
fn read_key(): i32 {
    return yue_read_key();
}

fn sleep_ms(milliseconds: i32): i32 {
    return yue_sleep_ms(milliseconds);
}

fn clear_screen(): i32 {
    return yue_clear_screen();
}

fn random(maximum: i32): i32 {
    return yue_random(maximum);
}

fn min(a: i32, b: i32): i32 {
    if (a < b) {
        return a;
    } else {
        return b;
    }
}

fn max(a: i32, b: i32): i32 {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fn abs(value: i32): i32 {
    if (value < 0) {
        return -value;
    } else {
        return value;
    }
}
