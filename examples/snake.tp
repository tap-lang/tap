fn main(): i32 {
    // The board keeps a one-cell border, so playable coordinates start at one.
    let width: i32 = 44;
    let height: i32 = 24;
    // let maximum_length: i32 = 40;
    const MAXIMUM_LENGTH: u64 = 40;

    // Parallel fixed arrays store snake coordinates because arrays are not function parameters yet.
    let snake_x: [i32; 40] = [0; 40];
    snake_x[0] = 21;
    snake_x[1] = 20;
    snake_x[2] = 19;
    
    let snake_y: [i32; 40] = [0; 40];
    snake_y[0] = 12;
    snake_y[1] = 12;
    snake_y[2] = 12;

    let length: i32 = 3;
    let direction_x: i32 = 1;
    let direction_y: i32 = 0;
    let score: i32 = 0;
    let game_over: i32 = 0;

    // Place the first food away from the initial snake body.
    let food_x: i32 = 1;
    let food_y: i32 = 1;
    let food_valid: i32 = 0;
    for (; food_valid == 0;) {
        food_x = random(width - 2) + 1;
        food_y = random(height - 2) + 1;
        food_valid = 1;
        for (let food_check: i32 = 0; food_check < length; food_check++) {
            if (food_x == snake_x[food_check]) {
                if (food_y == snake_y[food_check]) {
                    food_valid = 0;
                }
            }
        }
    }

    for (; game_over == 0;) {
        // Two terminal columns per cell compensate for characters being roughly twice as tall.
        clear_screen();
        print("4yue Snake | WASD/arrows: move | q: quit | score: %d\n", score);
        for (let border_x: i32 = 0; border_x < width; border_x++) {
            // A cactus emoji fills one two-column wall cell.
            print("🌵");
        }
        print("\n");

        for (let board_y: i32 = 1; board_y < (height - 1); board_y++) {
            print("🌵");
            for (let board_x: i32 = 1; board_x < (width - 1); board_x++) {
                let drawn: i32 = 0;
                if (board_x == snake_x[0]) {
                    if (board_y == snake_y[0]) {
                        // A bright green circle distinguishes the head while keeping a two-column cell.
                        print("🟢");
                        drawn = 1;
                    }
                }

                if (drawn == 0) {
                    for (let body_index: i32 = 1;
                         body_index < length; body_index++) {
                        if (board_x == snake_x[body_index]) {
                            if (board_y == snake_y[body_index]) {
                                // Full-color Unicode blocks make the body visible without ASCII glyphs.
                                print("🟩");
                                drawn = 1;
                            }
                        }
                    }
                }

                if (drawn == 0) {
                    if (board_x == food_x) {
                        if (board_y == food_y) {
                            // The mouse emoji occupies one two-column logical cell.
                            print("🐭");
                            drawn = 1;
                        }
                    }
                }
                if (drawn == 0) {
                    print("  ");
                }
            }
            print("🌵\n");
        }

        for (let bottom_x: i32 = 0; bottom_x < width; bottom_x++) {
            print("🌵");
        }
        print("\n");

        // read_key returns real key values: WASD ASCII, POSIX arrow final bytes A/B/C/D,
        // and Windows arrow scan codes 72/80/77/75.
        let key: i32 = read_key();
        if (key == 113) {
            break;
        } elseif (key == 119) {
            if (direction_y != 1) {
                direction_x = 0;
                direction_y = -1;
            }
        } elseif (key == 65) {
            if (direction_y != 1) {
                direction_x = 0;
                direction_y = -1;
            }
        } elseif (key == 72) {
            if (direction_y != 1) {
                direction_x = 0;
                direction_y = -1;
            }
        } elseif (key == 115) {
            if (direction_y != -1) {
                direction_x = 0;
                direction_y = 1;
            }
        } elseif (key == 66) {
            if (direction_y != -1) {
                direction_x = 0;
                direction_y = 1;
            }
        } elseif (key == 80) {
            if (direction_y != -1) {
                direction_x = 0;
                direction_y = 1;
            }
        } elseif (key == 97) {
            if (direction_x != 1) {
                direction_x = -1;
                direction_y = 0;
            }
        } elseif (key == 68) {
            if (direction_x != 1) {
                direction_x = -1;
                direction_y = 0;
            }
        } elseif (key == 75) {
            if (direction_x != 1) {
                direction_x = -1;
                direction_y = 0;
            }
        } elseif (key == 100) {
            if (direction_x != -1) {
                direction_x = 1;
                direction_y = 0;
            }
        } elseif (key == 67) {
            if (direction_x != -1) {
                direction_x = 1;
                direction_y = 0;
            }
        } elseif (key == 77) {
            if (direction_x != -1) {
                direction_x = 1;
                direction_y = 0;
            }
        }
        // A 160 ms frame interval reduces the original 120 ms update rate to 75%.
        sleep_ms(160);
        let next_x: i32 = snake_x[0] + direction_x;
        let next_y: i32 = snake_y[0] + direction_y;

        // Stop before writing an invalid head position into the coordinate arrays.
        if (next_x <= 0) {
            game_over = 1;
        }
        if (next_x >= (width - 1)) {
            game_over = 1;
        }
        if (next_y <= 0) {
            game_over = 1;
        }
        if (next_y >= (height - 1)) {
            game_over = 1;
        }
        if (game_over != 0) {
            break;
        }

        // Detect self-collision against the current body before shifting it.
        for (let collision_index: i32 = 1;
             collision_index < length; collision_index++) {
            if (next_x == snake_x[collision_index]) {
                if (next_y == snake_y[collision_index]) {
                    game_over = 1;
                    break;
                }
            }
        }
        if (game_over != 0) {
            break;
        }

        // Growing before the shift preserves the previous tail in the new final slot.
        let ate_food: i32 = 0;
        if (next_x == food_x) {
            if (next_y == food_y) {
                ate_food = 1;
                score = score + 10;
                if (length < MAXIMUM_LENGTH) {
                    length = length + 1;
                }
            }
        }

        for (let move_index: i32 = length - 1; move_index > 0; move_index--) {
            snake_x[move_index] = snake_x[move_index - 1];
            snake_y[move_index] = snake_y[move_index - 1];
        }
        snake_x[0] = next_x;
        snake_y[0] = next_y;

        // Generate another unoccupied food position after eating.
        if (ate_food != 0) {
            food_valid = 0;
            for (; food_valid == 0;) {
                food_x = random(width - 2) + 1;
                food_y = random(height - 2) + 1;
                food_valid = 1;
                for (let respawn_check: i32 = 0;
                     respawn_check < length; respawn_check++) {
                    if (food_x == snake_x[respawn_check]) {
                        if (food_y == snake_y[respawn_check]) {
                            food_valid = 0;
                        }
                    }
                }
            }
        }
    }

    // The final message remains visible after normal collision or q termination.
    print("Game over. Final score: %d\n", score);
    return 0;
}
