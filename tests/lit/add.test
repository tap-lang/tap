# 测试目标：验证两个整数相加功能

# RUN指令：调用编译器编译源码，生成可执行文件并运行
# %t 是lit自动生成的临时文件名前缀
# RUN: 你的编译器命令
RUN: %{compiler} %s -o %t.exe
RUN: %t.exe | FileCheck %s

# ----- 以下是你的语言源码 -----
int main() {
    int a = 10;
    int b = 20;
    int c = a + b;
    print(c);
    return 0;
}
# ----- 源码结束 -----

# CHECK指令：匹配程序输出
# CHECK-NEXT: 确保下一行精确匹配
CHECK: 30
CHECK-NEXT: {{^$}}    # 匹配空行，确保没有多余输出