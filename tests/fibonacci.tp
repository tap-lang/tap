
fn main(): int {
    let n: int = 3;
    print("Fibonacci number at position %d is %d\n", n, fibonacci(n));
    // print("Fibonacci number at position ");
    // print(n);
    // print(" is ");
    // let res = fibonacci(n);
    // print(res);
    // print("\n");
    return 0;
}

fn fibonacci(n: int): int {
    if(n <= 0) {
        return 0;
    } elseif (n == 1) {
        return 1;
    } else {
        return fibonacci(n - 1) + fibonacci(n - 2);
    }
}