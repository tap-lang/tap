// 模块级常量：导出后模块外写 constants.SCALE，模块内部直接写裸名 SCALE。
pub const SCALE: i32 = 3;

// 导出的字符串常量。模块外 `constants.LABEL.len()` 会被 Parser 拼成
// `constants.LABEL.len` 一个整串点名字——模块解析阶段必须认出最后一段是字符串内建，
// 否则会按「模块里有个叫 LABEL.len 的函数」去查而报错。
pub const LABEL: string = "tap";

// 模块内部引用自己导出的常量。
pub fn scaled(value: i32): i32 {
    return value * SCALE;
}

// 参数名刻意取成普通小写名，用来固定「裸名改写只匹配常量」——模块里同时存在一个
// 和参数同名的导出函数时，参数不能被误改成 __tap_module_N.xxx。
pub fn step(): i32 {
    let step: i32 = SCALE + 1;
    return step;
}

pub fn offset(value: i32): i32 {
    return value + step();
}
