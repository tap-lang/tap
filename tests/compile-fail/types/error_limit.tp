    let v1: i32 = "s1";
    let v2: i32 = "s2";
    let v3: i32 = "s3";
    let v4: i32 = "s4";
    let v5: i32 = "s5";
    let v6: i32 = "s6";
    let v7: i32 = "s7";
    let v8: i32 = "s8";
    let v9: i32 = "s9";
    let v10: i32 = "s10";
    let v11: i32 = "s11";
    return 0;
}

