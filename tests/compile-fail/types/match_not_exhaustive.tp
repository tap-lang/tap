enum Shape {
    Circle(f64),
    Rect(f64, f64),
}

fn main(): i32 {
    let shape: Shape = Shape.Circle(1.0);
    match (shape) {
        Shape.Circle(radius) => {
            print("%f\n", radius);
        }
    }
    return 0;
}

