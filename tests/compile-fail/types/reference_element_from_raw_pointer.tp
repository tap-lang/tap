// 裸指针不能凭空升级成受检查的借用，即使容器声明的是 `Vec<&T>`。
//
// 反过来（`&T` → `*T`）是允许的，那是「遗忘借用」：调用方显式放弃检查。
import std.vec as vec;

fn main(): i32 {
    let value: i32 = 1;
    let raw: *i32 = &value;
    let refs: Vec<&i32> = vec.new();
    refs.push(raw);
    return 0;
}

/** -- test
- .stderr
error: method 'push' argument 1 type mismatch
--> tests/compile-fail/types/reference_element_from_raw_pointer.tp:10:5
- .exit
1
-- */
