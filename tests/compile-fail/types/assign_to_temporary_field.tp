// 给临时值的字段赋值是静默无效的：地址落在 expression_address 开的临时槽里，store
// 完就丢了。这类写法必须报错，否则是「编译通过但什么都没发生」。
//
// 指针返回值不算：`make_ptr()[0].x = 1` 的根是下标表达式，写的是它指向的对象。
struct Point { left: i32 }

fn make(): Point {
    return Point { left: 1 };
}

fn main(): i32 {
    make().left = 2;
    return 0;
}

/** -- test
- .stderr
error: cannot assign to a field of a temporary value
--> tests/compile-fail/types/assign_to_temporary_field.tp:12:5
- .exit
1
-- */
