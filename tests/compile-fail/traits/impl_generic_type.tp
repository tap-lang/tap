// v1 只支持为具名的非泛型类型实现 trait；泛型目标在解析阶段就报错。
trait Show {
    fn show(self): String;
}

impl Show for Vec<i32> {
    fn show(value: Vec<i32>): String {
        return "vec";
    }
}

fn main(): i32 {
    return 0;
}

