// 返回类型也要对得上：trait 要求 string，impl 写成 i32。
trait Show {
    fn show(self): string;
}

struct Point { x: i32 }

impl Show for Point {
    fn show(value: Point): i32 {
        return 1;
    }
}

fn main(): i32 {
    return 0;
}

/** -- test
- .stderr
error: method 'show' returns 'i32', but trait 'Show' declares 'string'
- .exit
1
-- */
