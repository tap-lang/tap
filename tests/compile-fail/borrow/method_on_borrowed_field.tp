// 方法接收者也按字段路径判借用：握着 `&mut board.left` 时调 `board.right.bump()` 合法，
// 调 `board.left.bump()` 报错。
//
// `bump` 是 `&mut self`，等于对接收者取一次独占借用；接收者的粒度就是字段路径
//（`/left` / `/right`），所以兄弟字段互不影响。
struct Point { x: i32 }
struct Board { left: Point, right: Point }

trait Bump {
    fn bump(&mut self);
}

impl Bump for Point {
    fn bump(&mut self) {
        self.x = self.x + 1;
    }
}

fn main(): i32 {
    let board: Board = Board { left: Point { x: 1 }, right: Point { x: 2 } };
    let held: &mut Point = &mut board.left;
    board.right.bump();
    board.left.bump();
    held[0].x = 9;
    return 0;
}

/** -- test
- .stderr
error: 'board' is already mutably borrowed
--> tests/compile-fail/borrow/method_on_borrowed_field.tp:23:5
- .exit
1
