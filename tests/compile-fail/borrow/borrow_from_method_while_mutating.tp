// 方法返回的借用同样要登记到接收者上。
//
// `let r = p.peek();` 之后 r 就别名了 p，这时再写 p 必须报错 —— 否则 r 会读到
// 一个「既不是旧值也不是新值」的中间状态。
trait Peek {
    fn peek(&self): &i32;
}

struct Point { x: i32 }

impl Peek for Point {
    fn peek(&self): &i32 {
        return &self.x;
    }
}

fn main(): i32 {
    let p: Point = Point { x: 1 };
    let r: &i32 = p.peek();
    p.x = 2;
    print("%d\n", *r);
    return 0;
}

/** -- test
- .stderr
error: 'p.x' is borrowed and cannot be assigned here
- .exit
1
-- */
