// 最贴近真实代码的一条：`Vec` 的 `free` 按值接收，借用还活着时释放就是 use-after-free。
import std.vec as vec;

fn main(): i32 {
    let values: Vec<i32> = vec.new();
    values.push(1);
    let held: &Vec<i32> = &values;
    values.free();
    print("%llu\n", held.len());
    return 0;
}

/** -- test
- .stderr
error: cannot call method 'free' on 'values' while it is borrowed
- .exit
1
-- */
