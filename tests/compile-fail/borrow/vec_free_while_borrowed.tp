// 借用还没结束时释放容器：free 按值接收，等于「这个 Vec 用完了」，
// 调用方手里那个元素引用马上指向已释放的内存。
import std.vec as vec;

fn main(): i32 {
    let values: Vec<i32> = vec.new();
    values.push(1);
    let held: &i32 = values.get_ref(0);
    values.free();
    print("%d\n", *held);
    return 0;
}

/** -- test
- .stderr
error: cannot call method 'free' on 'values' while it is borrowed
- .exit
1
-- */
