import std.vec as vec;
import std.vec.Vec;

fn first(values: &Vec<i32>): &i32 {
    return &values.data[0];
}

// 签名合法（恰好一个引用参数），但返回的借用其实来自局部变量。
fn bad(values: &Vec<i32>): &i32 {
    let numbers: Vec<i32> = vec.new();
    numbers.push(10);
    return first(&numbers);
}

fn main(): i32 {
    return 0;
}

