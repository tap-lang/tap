// `...` 表示 C 的可变参数 ABI，只有 extern 函数才能声明：tap 自己的函数没有
// 可变参数的调用约定，写上去编译期就报错。
fn sum(first: i32, ...): i32 {
    return first;
}

fn main(): i32 {
    return sum(1, 2);
}

/** -- test
- .stderr
error: variadic parameters are only allowed on extern functions
--> tests/compile-fail/parser/variadic_non_extern.tp:3:20
- .exit
1
-- */
