// 成员名与模块文件重名 → 编译期直接报歧义，不静默偏向任何一侧。
// modules.ambig 有一个 pub 成员 inner，同时又存在模块 modules.ambig.inner。
import modules.ambig.inner;

fn main(): i32 {
    return 0;
}

