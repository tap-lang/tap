// 通配导入引入的裸名和本文件顶层定义重名 → 编译期报错。
// 这条取代了原来「本地定义优先于通配导入」的静默规则。
import modules.math.*;

fn double(value: i32): i32 {
    return value + 1;
}

fn main(): i32 {
    return double(10);
}

