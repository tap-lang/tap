import std.random;

fn main(): i32 {
    // Keep terminal-only calls linked without producing environment-dependent CI output.
    if (0) {
        read_key();
        clear_screen();
    }

    // Zero delay is deterministic, and random.random(1) can only return zero.
    print("%d %d\n", sleep_ms(0), random.random(1));
    return 0;
}

