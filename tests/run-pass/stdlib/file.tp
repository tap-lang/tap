// std.file 的流式读写：写、读回、追加、读到末尾，以及关闭之后的安全处理。
//
// 注意：测试的工作目录是仓库根目录，所以这里建的临时文件是相对路径。
// 正常结束时 remove 会删掉；万一中断，.gitignore 里的 *.tmp 兜底。
import std.file as file;

fn main(): i32 {
    let path: string = "std_file_test.tmp";

    // 写一个文件，关闭后重新打开读回。
    let out: File = file.open(path, "wb");
    print("open write=%d\n", file.is_open(out));
    print("write1=%lld\n", file.write(out, "hello "));
    print("write2=%lld\n", file.write(out, "tap"));
    print("close=%d\n", file.close(out));

    let input: File = file.open(path, "rb");
    print("open read=%d\n", file.is_open(input));
    print("chunk=%s\n", file.read(input, 5));
    print("rest=%s\n", file.read_all(input));
    print("eof=%d\n", file.eof(input));
    print("past_end=%llu\n", file.read(input, 8).len());
    print("close=%d\n", file.close(input));

    // 关闭之后的句柄应当被判定为无效，读写安全返回而不是崩溃。
    print("closed is_open=%d\n", file.is_open(input));
    print("closed write=%lld\n", file.write(input, "x"));

    // 打开不存在的文件：句柄为空，但同样可以安全调用。
    let missing: File = file.open("std_file_missing.tmp", "rb");
    print("missing is_open=%d\n", file.is_open(missing));

    print("remove=%d\n", file.remove(path));
    print("remove again=%d\n", file.remove(path));
    return 0;
}

/** -- test
- .stdout
open write=1
write1=6
write2=3
close=0
open read=1
chunk=hello
rest= tap
eof=1
past_end=0
close=0
closed is_open=0
closed write=-1
missing is_open=0
remove=0
remove again=-1
- .exit
0
-- */
