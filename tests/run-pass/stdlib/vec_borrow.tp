// Vec 的借用接口：读操作接收 `&Vec<T>`，`get_ref` 返回 `&T` 而不拷贝。
//
// 关键点是**借用期间容器不能再改** —— 扩容会重新分配缓冲区，之前拿到的元素引用
// 立刻悬垂。所以下面的元素引用都限制在块里，出块之后才能继续 push。
import std.vec as vec;

// 只读借用：函数内部不需要拷贝整个容器。
fn sum(values: &Vec<i32>): i32 {
    let total: i32 = 0;
    for (let i: uint = 0; i < values.len(); i = i + 1) {
        total = total + values.get(i);
    }
    return total;
}

fn main(): i32 {
    let values: Vec<i32> = vec.new();
    values.push(1);
    values.push(2);
    values.push(3);

    print("%d\n", sum(&values));

    // 元素引用只活在这个 if 块里。
    if (values.len() > 0) {
        let first: &i32 = values.get_ref(0);
        print("%d\n", *first);
    }

    // 出块之后借用已经结束，可以继续改。
    values.push(4);
    print("%llu %d\n", values.len(), values.get(3));

    values.free();
    return 0;
}

/** -- test
- .stdout
6
1
4 4
- .exit
0
-- */
