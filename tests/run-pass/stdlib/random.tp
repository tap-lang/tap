import std.random;

fn main(): i32 {
    // random.random(1) can only be 0; a wider range is always within [0, 1000).
    let first: i32 = random.random(1);
    let second: i32 = random.random(1000);
    print("%d %d\n", first, second >= 0 && second < 1000);
    return 0;
}

/** -- test
- .stdout
0 1
- .exit
0
-- */
