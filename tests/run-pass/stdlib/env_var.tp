// std.env 的环境变量访问。vars() 返回 Vec<string>，元素个数就是真实条目数。
import std.env;
import std.vec as vec;

fn main(): i32 {
    let values: Vec<string> = env.vars();
    if (env.var("TAP_STD_PATH").len() > 0) {
        print("std path set\n");
    }
    print("missing len %u\n", env.var("TAP_ENV_VAR_DOES_NOT_EXIST").len());
    if (env.varc() > 0) {
        print("env count set\n");
    }
    if (values.len() > 0) {
        print("first env set\n");
    }
    vec.free(values);
    return 0;
}

/** -- test
- .stdout
std path set
missing len 0
env count set
first env set
- .exit
0
-- */
