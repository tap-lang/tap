import std.memory as memory;

fn main(): i32 {
    let values: ptr<string> = memory.malloc(16);
    values[0] = "first";

    values = memory.realloc(values, 32);
    values[1] = "second";
    print("%s %s\n", values[0], values[1]);

    return memory.free(values);
}

/** -- test
- .stdout
first second
- .exit
0
-- */
