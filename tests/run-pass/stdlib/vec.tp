import std.vec as vec;

struct Pair {
    left: i32,
    right: i32,
}

// 结构体是值类型；需要就地修改或避免拷贝时可以传指针。
fn accept_values(values: *Vec<string>): i32 {
    return 0;
}

fn main(): i32 {
    let numbers: Vec<i32> = vec.with_capacity(1);
    numbers.push(10);
    numbers.push(20);
    numbers.push(30);
    numbers.set(1, 22);
    print("%llu %llu %d %d\n",
          numbers.len(), numbers.capacity(), numbers.get(0), numbers.get(1));

    numbers.clear();
    numbers.push(40);
    print("%llu %d\n", numbers.len(), numbers.get(0));

    let words: Vec<string> = vec.new();
    words.push("tap");
    words.push("lang");
    print("%s %s\n", words.get(0), words.get(1));

    // 增长超过初始容量 8，会触发多次扩容。
    let many: Vec<string> = vec.new();
    many.push("zero");
    many.push("one");
    many.push("two");
    many.push("three");
    many.push("four");
    many.push("five");
    many.push("six");
    many.push("seven");
    many.push("eight");
    print("%llu %s %s\n", many.len(), many.get(0), many.get(8));

    accept_values(&many);

    let pairs: Vec<Pair> = vec.new<Pair>();
    pairs.push(Pair { left: 4, right: 2 });
    let pair: Pair = pairs.get(0);
    print("%d\n", pair.left + pair.right);

    numbers.free();
    words.free();
    many.free();
    return pairs.free();
}

/** -- test
- .stdout
3 4 10 22
1 40
tap lang
9 zero eight
6
- .exit
0
-- */
