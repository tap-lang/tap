// print 现在是 Prelude 里的普通 tap 函数（printf 的薄封装），不再是编译器内建语句。
// 这里钉住它的两种形态：格式串 + 变参转发，以及单实参按类型自动挑格式串。
fn main(): i32 {
    // 一、跟 printf 完全一致：第一个实参当格式串，其余走变参转发。
    print("plain\n");
    print("%s=%d\n", "answer", 42);
    print("%05.2f|%x|%c|%%\n", 3.14159, 255, 65);

    // 二、只给一个实参、且它不是字符串字面量时，编译器按实参类型自动挑格式串。
    print(42);
    print("\n");

    let small: i8 = -3;
    print(small);
    print("\n");

    let byte: u8 = 200;
    print(byte);
    print("\n");

    let single: f32 = 1.5;
    print(single);
    print("\n");

    let wide: i64 = 9007199254740993;
    print(wide);
    print("\n");

    // 三、作为函数它是有返回值的（printf 写出的字符数），可以参与运算；
    // 也能出现在表达式位置 —— 这在它还是内建语句的时候是做不到的。
    let written: i32 = print("counted\n");
    print("written=%d\n", written);
    return 0;
}

/** -- test
- .stdout
plain
answer=42
03.14|ff|A|%
42
-3
200
1.500000
9007199254740993
counted
written=8
- .exit
0
-- */
