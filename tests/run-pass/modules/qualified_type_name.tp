// 限定类型名 `alias.Type`：模块别名 + 类型名，中间一个点。
//
// 动机：两个命名空间导入的模块都导出 `Point` 时，裸名只能报歧义（见
// compile-fail/modules/ambiguous_pub_type.tp），唯一能显式消歧的写法就是 `a.Point`。
//
// 同一条解析路径要覆盖四个位置：类型标注、结构体字面量、泛型实参、match 模式里的枚举名。
// 它们在 Parser 里是四处不同的代码，最后都落到 module.c 的 resolve_type_name 上。
import modules.clash_a as a;
import modules.clash_b as b;
import modules.payload as payload;
import std.vec as vec;

fn main(): i32 {
    // ① 类型标注 + ② 结构体字面量：两个同名结构体各取各的。
    let p: a.Point = a.Point { x: 3 };
    let q: b.Point = b.Point { y: 4 };
    print("%d %d\n", p.x, q.y);

    // ③ 限定名当泛型实参。
    let items: vec.Vec<b.Point> = vec.new();
    items.push(q);
    print("len=%d y=%d\n", items.len(), items.get(0).y);

    // ④ 限定名的枚举构造 + match 模式（模式里的枚举名带前缀）。
    let choice: payload.Choice = payload.Choice.Some(5);
    match (choice) {
        payload.Choice.Some(value) => { print("some %d\n", value); }
        payload.Choice.None(value) => { print("none %d\n", value); }
    }
    return 0;
}

/** -- test
- .stdout
3 4
len=1 y=4
some 5
- .exit
0
-- */
