// `%` 取模：与 * / 同级，有符号按 C 语义（余数符号跟随被除数），无符号按无符号除法。
fn main(): i32 {
    print("%d\n", 17 % 5);
    print("%d\n", -17 % 5);
    print("%d\n", 17 % -5);

    // 优先级：% 与 * / 同级且左结合
    print("%d\n", 2 + 7 % 3);
    print("%d\n", 2 * 7 % 3);
    print("%d\n", 20 / 3 % 4);

    let a: u32 = 17;
    let b: u32 = 5;
    print("%u\n", a % b);

    let c: u64 = 1000000007;
    print("%llu\n", c % 97);

    let d: i8 = -8;
    print("%d\n", d % 3);

    return 0;
}

