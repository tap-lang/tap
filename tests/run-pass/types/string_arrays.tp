fn main(): i32 {
    let names: [string; 3] = ["Alice", "Bob", "Carol"];
    print("%s %s %s\n", names[0], names[1], names[2]);

    names[1] = "David";
    print("%s\n", names[1]);

    let blanks: [string; 3] = ["empty"; 3];
    print("%s %s %s\n", blanks[0], blanks[1], blanks[2]);
    return 0;
}

/** -- test
- .stdout
Alice Bob Carol
David
empty empty empty
- .exit
0
-- */
