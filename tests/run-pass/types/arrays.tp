fn main(): i32 {
    let values: [i32; 4] = [10, 20, 30, 40];
    let array: i32 = 7;
    print("%d %d\n", values[0], values[3]);

    values[1] = 99;
    let sum: i32 = 0;
    for (let i: i32 = 0; i < 4; i++) {
        sum = sum + values[i];
    }

    print("%d %d %d\n", sum, values[1], array);
    return 0;
}

/** -- test
- .stdout
10 40
179 99 7
- .exit
0
-- */