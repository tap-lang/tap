// `...` 转发不是 print 的专利：任何「变参 + 函数体恰好一句纯转发」的函数都能用。
// 这类函数在编译期被整个合并到目标上，所以转发不产生额外的函数调用。
//
// 转发的目标必须是一个**真实的**变参函数（extern）：转发函数自己没有可供跳转的实体，
// 所以不能把另一个转发函数当目标。这里自己声明一个 libc 的 printf 来转发。
extern fn printf(format: string, ...): i32;

fn log_line(prefix: string, ...): i32 {
    return printf(prefix, ...);
}

fn main(): i32 {
    log_line("[log] %d %s\n", 42, "ok");

    // 包装函数同样保留 printf 的返回值。
    let written: i32 = log_line("[log] written\n");
    printf("written=%d\n", written);
    return 0;
}

/** -- test
- .stdout
[log] 42 ok
[log] written
written=14
- .exit
0
-- */
