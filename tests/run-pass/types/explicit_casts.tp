// 显式标量转换：整数、bool、string，以及浮点数到 string。
fn main(): i32 {
    let x: i32 = true as i32;
    let ok: bool = 1 as bool;
    let s: string = 123 as string;
    let a: i32 = "123" as i32;
    let s2: string = 3.14 as string;
    let b: string = true as string;
    let b2: bool = "true" as bool;
    let zero: bool = "0" as bool;
    let false_i32: i32 = false as i32;
    let false_bool: bool = 0 as bool;
    let false_text: string = false as string;
    let false_from_text: bool = "false" as bool;

    // 每一种整数类型都覆盖 string -> integer -> string。
    let int_value: int = "-123" as int;
    let uint_value: uint = "123" as uint;
    let i8_value: i8 = "-8" as i8;
    let u8_value: u8 = "8" as u8;
    let i16_value: i16 = "-16" as i16;
    let u16_value: u16 = "16" as u16;
    let i32_value: i32 = "-32" as i32;
    let u32_value: u32 = "32" as u32;
    let i64_value: i64 = "-64" as i64;
    let u64_value: u64 = "64" as u64;
    let i128_max: i128 = "170141183460469231731687303715884105727" as i128;
    let u128_max: u128 = "340282366920938463463374607431768211455" as u128;
    let i128_negative: i128 = "-170141183460469231731687303715884105728" as i128;
    let int_text: string = int_value as string;
    let uint_text: string = uint_value as string;
    let i8_text: string = i8_value as string;
    let u8_text: string = u8_value as string;
    let i16_text: string = i16_value as string;
    let u16_text: string = u16_value as string;
    let i32_text: string = i32_value as string;
    let u32_text: string = u32_value as string;
    let i64_text: string = i64_value as string;
    let u64_text: string = u64_value as string;
    let i128_text: string = i128_max as string;
    let u128_text: string = u128_max as string;
    let i128_negative_text: string = i128_negative as string;
    print("%d %d %s %d %s %s %d %d\n",
          x, ok, s, a, s2, b, b2, zero);
    print("%d %d %s %d\n", false_i32, false_bool, false_text, false_from_text);
    print("%s %s %s %s %s %s %s %s %s %s\n",
          int_text, uint_text, i8_text, u8_text, i16_text,
          u16_text, i32_text, u32_text, i64_text, u64_text);
    print("%s\n%s\n%s\n%s\n", i128_text, u128_text, i128_negative_text, false_text);
    return 0;
}

/** -- test
- .stdout
1 1 123 123 3.14 true 1 0
0 0 false 0
-123 123 -8 8 -16 16 -32 32 -64 64
170141183460469231731687303715884105727
340282366920938463463374607431768211455
-170141183460469231731687303715884105728
false
- .exit
0
-- */
