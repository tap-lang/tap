import std.vec as vec;
import std.vec.Vec;

struct Pair { left: i32, right: i32 }

// 返回借用的函数：借用来自唯一那个引用参数，调用方按实参的寿命继续跟踪。
fn first(values: &Vec<i32>): &i32 {
    return &values.data[0];
}

fn left_of(pair: &Pair): &i32 {
    return &pair.left;
}

// 借用穿过一次函数调用再传出去，依然是「借自参数」。
fn head_or(values: &Vec<i32>, fallback: i32): i32 {
    let head: &i32 = first(values);
    if (head[0] > 0) {
        return head[0];
    }
    return fallback;
}

fn main(): i32 {
    let numbers: Vec<i32> = vec.new();
    numbers.push(10);
    numbers.push(20);

    if (numbers.len() == 2) {
        print("%d\n", first(&numbers)[0]);
        print("%d\n", head_or(&numbers, 0));
    }
    numbers.free();

    let pair: Pair = Pair { left: 7, right: 8 };
    print("%d\n", left_of(&pair)[0]);
    return 0;
}

/** -- test
- .stdout
10
10
7
- .exit
0
-- */
