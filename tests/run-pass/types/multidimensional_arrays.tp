fn main(): i32 {
    // 二维数组支持递归类型、嵌套字面量和标量元素赋值。
    let matrix: [[i32, 3], 2] = [[1, 2, 3], [4, 5, 6]];
    matrix[1][0] = 40;

    // 三维数组用来验证索引链可继续递归。
    let cube: [[[i32, 2], 2], 2] = [
        [[1, 2], [3, 4]],
        [[5, 6], [7, 8]]
    ];
    cube[0][1][1] = 44;

    print("%d %d %d %d\n", matrix[0][2], matrix[1][0],
          cube[1][0][1], cube[0][1][1]);
    return 0;
}

/** -- test
- .stdout
3 40 6 44
- .exit
0
-- */
