fn echo(value: String): String {
    return value;
}

fn main(): i32 {
    let greeting: String = "Hello";
    let name = echo("tap");
    print("%s, %s!\n", greeting, name);

    greeting = "line 1\nline 2";
    print("%s\n", greeting);
    print("tab:\tquote:\" slash:\\\n");
    return 0;
}

/** -- test
- .stdout
Hello, tap!
line 1
line 2
tab:	quote:" slash:\
- .exit
0
-- */
