// 借用粒度是**字段路径**，不是整个变量。
//
// `&mut point.left` 只占住 `point.left`：写 `point.right`、借 `point.right`、读
// `point.right` 都还合法。反方向（借了字段再动整个结构体）仍然报错，见
// compile-fail/borrow/use_whole_while_field_borrowed.tp。
//
// 数组下标也算一段路径：常量下标互不相干，非常量下标按重叠处理。
//
// 路径按字段/下标逐段累积，写和读走同一套（`p.x = v` 现在也是字段访问节点）。

struct Inner { value: i32 }
struct Point { left: i32, right: i32, inner: Inner }

fn main(): i32 {
    let point: Point = Point { left: 1, right: 2, inner: Inner { value: 3 } };

    // 握住 left 的独占借用，仍然可以写/读 right。
    let left: &mut i32 = &mut point.left;
    point.right = 20;
    print("%d %d\n", left[0], point.right);

    // 两个互不相交的字段可以同时独占借用。
    let right: &mut i32 = &mut point.right;
    right[0] = 30;
    left[0] = 10;
    print("%d %d\n", left[0], right[0]);

    // 第三个兄弟字段照样能借：三条路径互不为前缀。
    let inner: &mut Inner = &mut point.inner;
    print("%d\n", inner[0].value);

    // 常量下标：不同元素互不相干。
    let items: [i32; 3] = [1, 2, 3];
    let first: &mut i32 = &mut items[0];
    items[1] = 7;
    print("%d %d\n", first[0], items[1]);
    return 0;
}

/** -- test
- .stdout
1 20
10 30
3
1 7
- .exit
0
-- */
