// 浮点四则运算、取模、与整数的混合运算，以及一元负号。
fn main(): i32 {
    let a: f64 = 1.5;
    let b: f64 = 2.25;

    print("%f %f %f %f\n", a + b, a * b, b / a, b - a);
    print("%f\n", 7.5 % 2.0);
    print("%f\n", 1.5 + 2);
    print("%f\n", -3.25);

    return 0;
}

