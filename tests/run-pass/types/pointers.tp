import std.memory as memory;

fn main(): i32 {
    let values: ptr<string> = memory.malloc(64);
    values[0] = "alpha";
    values[1] = "beta";
    print("%s %s\n", values[0], values[1]);

    values = memory.realloc(values, 128);
    values[2] = "gamma";
    print("%s\n", values[2]);
    return memory.free(values);
}

/** -- test
- .stdout
alpha beta
gamma
- .exit
0
-- */
