// 顶层字符串常量。
//
// 回归点：`constant_initializer` 原先只处理整数和浮点，字符串落到「initializer type
// mismatch」。字符串在 LLVM 里是 i8*，全局初始化器只能是常量表达式，所以不能走
// LLVMBuildGlobalStringPtr（那是指令，需要函数上下文），得手工落成「私有字节数组 +
// 指向它的常量 GEP」两块。
//
// 顺带钉住「全局常量当方法接收者」：`A.len()` 原先只查局部符号表，找不到就报
// undefined variable——全局常量不在里面。
const EMPTY: string = "";
const A: string = "alpha";
const B: string = "beta";
const SAME: string = "alpha";
const GREETING: string = "hello, tap";
const WIDE: string = "中文";

fn take(value: string): string {
    return value;
}

fn main(): i32 {
    // 空串与长度
    print("empty=[%s] len=%u\n", EMPTY, EMPTY.len());
    print("len=%u %u %u\n", A.len(), B.len(), GREETING.len());

    // UTF-8 按字节计数：「中文」是 6 字节
    print("wide=%s len=%u\n", WIDE, WIDE.len());

    // 方法调用：全局常量当接收者
    print("byte=%u slice=%s\n", A.byte_at(0), A.slice(1, 3));
    print("empty byte_at 越界不崩: len=%u\n", EMPTY.len());

    // 内容相同的两个常量各自独立
    print("same=%s cmp=%d %d\n", SAME, A == SAME, A == B);

    // 当值传给函数
    print("take=%s\n", take(GREETING));

    return 0;
}

/** -- test
- .stdout
empty=[] len=0
len=5 4 10
wide=中文 len=6
byte=97 slice=lp
empty byte_at 越界不崩: len=0
same=alpha cmp=1 0
take=hello, tap
- .exit
0
-- */
