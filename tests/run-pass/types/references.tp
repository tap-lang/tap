struct Pair {
    left: i32,
    right: i32
}

fn increment(value: ptr<i32>): i32 {
    value[0] = value[0] + 1;
    return 0;
}

fn main(): i32 {
    let value: i32 = 40;
    let value_ref = &value;
    increment(value_ref);
    increment(&value);

    let pair: Pair = Pair { left: 9, right: 20 };
    increment(&pair.left);

    let items: [i32; 2] = [30, 39];
    increment(&items[1]);

    print("%d %d %d\n", value, pair.left, items[1]);
    return 0;
}

/** -- test
- .stdout
42 10 40
- .exit
0
-- */
