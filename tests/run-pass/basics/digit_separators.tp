// 数字分隔符 '_'：只是可读性糖，不改变值。可以出现在任意两个数字之间。
const LIMIT: i32 = 1_000_000;

fn main(): int {
    let dec: i32 = 1_000_000;
    let hex: i32 = 0xFF_FF;
    let binary: i32 = 0b1010_0000;
    let octal: i32 = 0o7_777;
    print("%d %d %d %d %d\n", dec, hex, binary, octal, LIMIT);

    // 浮点也支持：整数部分、小数部分、指数部分都能分组
    let fraction: f32 = 1_000.5;
    let exponent: f32 = 1.5e1_0;
    print("%f %f\n", fraction, exponent);

    // 宽整数分组之后可以对着位数读
    let wide: u64 = 0xFFFF_FFFF_FFFF_FFFF;
    let huge: u128 = 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF;
    let same: u128 = 340_282_366_920_938_463_463_374_607_431_768_211_455;
    print("%lu %d\n", wide, huge == same);

    // 数组长度和重复初始化同样接受分隔符
    let table: [i32; 1_0] = [0; 1_0];
    print("%d %d\n", table[9], 0x1_0 + 0b1_0);
    return 0;
}

/** -- test
- .stdout
1000000 65535 160 4095 1000000
1000.500000 15000000512.000000
18446744073709551615 1
0 18
- .exit
0
-- */
