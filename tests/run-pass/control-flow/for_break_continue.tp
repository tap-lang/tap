fn main(): i32 {
    let sum: i32 = 0;
    for (let i: i32 = 0; i < 10; i++) {
        if (i == 3) {
            continue;
        }
        if (i == 7) {
            break;
        }
        sum = sum + i;
    }

    let nested: i32 = 0;
    for (let i: i32 = 0; i < 3; i++) {
        for (let j: i32 = 0; j < 4; j++) {
            if (j == 1) {
                continue;
            }
            if (i == 2) {
                break;
            }
            nested++;
        }
    }

    let escaped: i32 = 0;
    for (;;) {
        escaped = 1;
        break;
    }

    print("%d %d %d\n", sum, nested, escaped);
    return 0;
}

